# Login com Google (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth "Aplicativo da Web")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Gere com: npx auth secret
AUTH_SECRET=
# Postgres (Neon). A integração da Vercel preenche automaticamente.
DATABASE_URL=
# E-mails (do Google) com acesso ao painel /admin, separados por vírgula
ADMIN_EMAILS=
# Só em desenvolvimento: libera o /admin sem login para testes locais
# ADMIN_DEV_BYPASS=1
